{
  "name": "q-runner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:levels": "tsx scripts/generateBuiltins.ts",
    "generate:icons": "tsx scripts/generateIcons.ts",
    "validate:levels": "tsx scripts/validateBuiltins.ts",
    "build": "pnpm validate:levels && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "preview": "tsx scripts/renderPreview.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:levels"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "lucide-react": "^0.554.0",
    "nanoid": "^5.1.6",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
